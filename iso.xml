<?xml version="1.0" encoding="utf-8"?>
<!--
	Disc layout, processed by CMake and mkpsxiso (same format as the SDK
	template). All file names must be 8.3 format and paths are relative to the
	build directory; use ${PROJECT_SOURCE_DIR} for files in the source tree.
-->
<iso_project>
	<track type="data">
		<identifiers
			system			="PLAYSTATION"
			volume			="FRONTIER"
			volume_set		="FRONTIER"
			publisher		="HOMEBREW"
			data_preparer	="PSN00BSDK ${PSN00BSDK_VERSION}"
			application		="PLAYSTATION"
			copyright		="README.TXT;1"
		/>

		<directory_tree>
			<file name="SYSTEM.CNF"		type="data" source="${PROJECT_SOURCE_DIR}/system.cnf" />
			<file name="FRONTIER.EXE"	type="data" source="frontier.exe" />

			<dummy sectors="1024"/>
		</directory_tree>
	</track>
</iso_project>
